---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<url><loc>{{ '/' | absolute_url }}</loc></url>
<url><loc>{{ '/blog/' | absolute_url }}</loc></url>
{% for post in site.posts %}<url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>{% endfor %}
{% for post in site.data.legacy_posts %}<url><loc>{{ post.url | absolute_url | xml_escape }}</loc><lastmod>{{ post.date }}</lastmod></url>{% endfor %}
</urlset>
